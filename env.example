# Configuración de la aplicación
FLASK_ENV=production
FLASK_DEBUG=false

# Configuración de Redis
REDIS_URL=redis://localhost:6379/0

# Configuración de sesiones
SESSION_SECRET_KEY=tu_clave_secreta_muy_larga_y_compleja_aqui

# Configuración de cookies para Cloudflare Tunnel
SESSION_COOKIE_SECURE=true

# Configuración de autenticación
ADMIN_USER=admin
ADMIN_PASS=tu_password_seguro_aqui

# Configuración de CORS para Cloudflare Tunnel
# Dejar vacío para permitir URLs dinámicas de Cloudflare
# O especificar dominios conocidos separados por comas
ALLOWED_ORIGINS=

# Configuración de Gunicorn
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=30

# Configuración específica para Cloudflare Tunnel
# Estas variables ayudan a la aplicación a detectar el entorno
CLOUDFLARE_TUNNEL=true
BEHIND_PROXY=true 